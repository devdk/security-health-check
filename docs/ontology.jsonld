    {
      "@id": "shc:component/wordpress-core",
      "@type": "Component",
      "label": "WordPress core",
      "definition": "The WordPress application itself."
    },
    {
      "@id": "shc:component/plugin",
      "@type": "Component",
      "label": "Plugin",
      "definition": "A WordPress plugin, active or inactive."
    },
    {
      "@id": "shc:component/theme",
      "@type": "Component",
      "label": "Theme",
      "definition": "A WordPress theme, including parent themes."
    },
    {
      "@id": "shc:component/php-runtime",
      "@type": "Component",
      "label": "PHP runtime",
      "definition": "The PHP version the site runs on."
    },
    {
      "@id": "shc:component/web-server",
      "@type": "Component",
      "label": "Web server",
      "definition": "The server software in front of WordPress (Apache, nginx, LiteSpeed)."
    },
    {
      "@id": "shc:component/tls-endpoint",
      "@type": "Component",
      "label": "HTTPS endpoint",
      "definition": "The TLS certificate and protocol configuration serving the site."
    },
    {
      "@id": "shc:component/http-response",
      "@type": "Component",
      "label": "HTTP responses",
      "definition": "Headers and cookies the site sends to browsers."
    },
    {
      "@id": "shc:component/login-endpoint",
      "@type": "Component",
      "label": "Login page",
      "definition": "wp-login.php and the wp-admin area."
    },
    {
      "@id": "shc:component/rest-api",
      "@type": "Component",
      "label": "REST API",
      "definition": "The WordPress REST API under /wp-json/."
    },
    {
      "@id": "shc:component/xmlrpc-endpoint",
      "@type": "Component",
      "label": "XML-RPC endpoint",
      "definition": "The legacy remote-publishing interface at /xmlrpc.php."
    },
    {
      "@id": "shc:component/public-files",
      "@type": "Component",
      "label": "Publicly served files",
      "definition": "Files and folders the web server will hand to anyone who asks."
    },
    {
      "@id": "shc:component/user-accounts",
      "@type": "Component",
      "label": "User accounts",
      "definition": "WordPress users, especially administrators."
    },
    {
      "@id": "shc:component/site-files",
      "@type": "Component",
      "label": "Site files",
      "definition": "PHP, configuration and uploaded files on the server."
    },
    {
      "@id": "shc:control/hsts",
      "@type": "Control",
      "label": "HTTP Strict Transport Security",
      "definition": "Tells browsers to only ever use HTTPS for the site."
    },
    {
      "@id": "shc:control/csp",
      "@type": "Control",
      "label": "Content Security Policy",
      "definition": "Limits which scripts and resources a page may load."
    },
    {
      "@id": "shc:control/frame-protection",
      "@type": "Control",
      "label": "Frame protection",
      "definition": "Stops other sites embedding yours in a frame (clickjacking)."
    },
    {
      "@id": "shc:control/two-factor-authentication",
      "@type": "Control",
      "label": "Two-factor authentication",
      "definition": "A second proof of identity beyond the password."
    },
    {
      "@id": "shc:control/login-rate-limiting",
      "@type": "Control",
      "label": "Login rate limiting",
      "definition": "Slows or blocks repeated failed sign-in attempts."
    },
    {
      "@id": "shc:control/web-application-firewall",
      "@type": "Control",
      "label": "Web application firewall",
      "definition": "Filters malicious requests before they reach WordPress."
    },
    {
      "@id": "shc:control/automatic-updates",
      "@type": "Control",
      "label": "Automatic updates",
      "definition": "Installs security releases without waiting for a person."
    },
    {
      "@id": "shc:control/offsite-backups",
      "@type": "Control",
      "label": "Off-site backups",
      "definition": "Backups stored away from the web server, out of public reach."
    },
    {
      "@id": "shc:control/least-privilege",
      "@type": "Control",
      "label": "Least privilege",
      "definition": "Each account has only the access it needs."
    },
    {
      "@id": "shc:remediation/update-wordpress-core",
      "@type": "Remediation",
      "label": "Update WordPress",
      "definition": "Take a backup, then update WordPress from Dashboard → Updates to the latest release.",
      "effort": "minutes",
      "steps": [
        "Make a full backup of files and database (most hosts have a one-click backup).",
        "Sign in to WordPress and go to Dashboard → Updates.",
        "Click \"Update to version …\" and wait for it to finish; do not close the page.",
        "Open a few pages of the site to check it still works, then run a new scan."
      ]
    },
    {
      "@id": "shc:remediation/update-affected-component",
      "@type": "Remediation",
      "label": "Update the affected software",
      "definition": "Update the affected plugin, theme or WordPress core to the fixed version or later. If no fix exists, deactivate and delete it until one is released.",
      "effort": "minutes",
      "steps": [
        "Make a backup of the site.",
        "Go to Plugins (or Appearance → Themes) and find the item named in this finding.",
        "Click \"Update now\". If no update is offered, check the developer’s site; premium plugins often update from their own account page.",
        "If no fixed version exists yet, deactivate and delete it until one is released, or replace it with an alternative.",
        "Run a new scan to confirm the issue is gone."
      ]
    },
    {
      "@id": "shc:remediation/remove-unused-component",
      "@type": "Remediation",
      "label": "Remove unused plugins and themes",
      "definition": "Delete plugins and themes you are not using. Deactivated code can still be reached and exploited.",
      "effort": "minutes",
      "steps": [
        "Go to Plugins → Installed Plugins and look for anything marked \"Inactive\".",
        "For each one you do not need, click \"Delete\" (deactivating is not enough: the files stay on the server).",
        "Do the same under Appearance → Themes, keeping only your active theme and one default theme as a fallback."
      ]
    },
    {
      "@id": "shc:remediation/enable-auto-updates",
      "@type": "Remediation",
      "label": "Turn on automatic updates",
      "definition": "Enable automatic updates for WordPress core, plugins and themes so security fixes install without delay.",
      "effort": "minutes",
      "steps": [
        "Go to Plugins → Installed Plugins and click \"Enable auto-updates\" for each trusted plugin.",
        "Go to Appearance → Themes, open each theme and enable auto-updates.",
        "In Dashboard → Updates, choose to keep WordPress updated automatically for all new versions.",
        "Make sure you have automatic daily backups so a bad update can be rolled back."
      ]
    },
    {
      "@id": "shc:remediation/hide-version-info",
      "@type": "Remediation",
      "label": "Stop advertising version numbers",
      "definition": "Remove the WordPress generator tag and version query strings. This slows attackers down; keeping software updated is the real fix.",
      "effort": "minutes",
      "steps": [
        "Install a reputable security plugin that offers \"remove WordPress version\" or \"hide generator tag\".",
        "Turn that option on, then view your page source and check the generator tag is gone.",
        "Keep updating WordPress regardless: hiding the number only slows attackers down."
      ]
    },
    {
      "@id": "shc:remediation/block-readme-files",
      "@type": "Remediation",
      "label": "Block plugin readme files",
      "definition": "Deny web access to readme.txt and changelog files inside wp-content so plugin versions are not advertised.",
      "effort": "minutes",
      "steps": [
        "Ask your host or developer to block web access to readme.txt and changelog.txt files under /wp-content/.",
        "On Apache this is a short rule in .htaccess; on nginx a location block. Many security plugins can add it for you.",
        "Check that https://your-site/wp-content/plugins/<a plugin>/readme.txt now returns \"Forbidden\" or \"Not found\"."
      ]
    },
    {
      "@id": "shc:remediation/hide-php-version",
      "@type": "Remediation",
      "label": "Hide the PHP version",
      "definition": "Set expose_php = Off in php.ini (or ask your host) so the X-Powered-By header no longer reveals the PHP version.",
      "effort": "minutes",
      "steps": [
        "In your hosting control panel, look for PHP settings (often \"PHP Options\" or \"php.ini editor\").",
        "Set expose_php to Off and save.",
        "If you cannot find it, ask your host to turn off the X-Powered-By header for your site."
      ]
    },
    {
      "@id": "shc:remediation/upgrade-php",
      "@type": "Remediation",
      "label": "Upgrade PHP",
      "definition": "Move the site to a PHP version that still receives security updates. Most hosts offer this in their control panel.",
      "effort": "hour",
      "steps": [
        "Check in Tools → Site Health that your plugins and theme support a current PHP version.",
        "Make a backup, then switch the site to a supported PHP version in your hosting control panel (look for \"PHP version\" or \"PHP selector\").",
        "Browse the site and the admin area to check nothing broke; switch back immediately if something did, and ask a developer to fix the incompatible plugin.",
        "If your host cannot offer a supported PHP version, plan a move to one that can."
      ]
    },
    {
      "@id": "shc:remediation/remove-exposed-file",
      "@type": "Remediation",
      "label": "Remove the exposed file",
      "definition": "Delete the file from the web server or block access to it, then check your access logs to see whether anyone downloaded it.",
      "effort": "minutes",
      "steps": [
        "Using your host’s file manager or SFTP, delete the file named in this finding (or move it outside the public web folder).",
        "Reload its address in a browser and check you now get \"Not found\".",
        "Ask your host for access logs and check whether anyone downloaded it before you removed it.",
        "Find out how it got there (a backup plugin, an editor, a developer) so it does not come back."
      ]
    },
    {
      "@id": "shc:remediation/rotate-secrets",
      "@type": "Remediation",
      "label": "Change the leaked secrets",
      "definition": "Assume the contents were copied. Change the database password, regenerate the WordPress keys and salts, and replace any API keys the file contained.",
      "effort": "hour",
      "steps": [
        "Change the database password in your hosting control panel, then update DB_PASSWORD in wp-config.php to match.",
        "Generate new keys at https://api.wordpress.org/secret-key/1.1/salt/ and replace the AUTH_KEY … NONCE_SALT lines in wp-config.php. This signs everyone out.",
        "Replace any other API keys or passwords the file contained (payment, email, storage services).",
        "Reset the passwords of all administrator accounts."
      ]
    },
    {
      "@id": "shc:remediation/block-hidden-files",
      "@type": "Remediation",
      "label": "Block hidden files",
      "definition": "Configure the web server to refuse requests for dot-files and folders such as .git and .env.",
      "effort": "minutes",
      "steps": [
        "Ask your host or developer to deny web access to any file or folder whose name starts with a dot (.git, .env, .svn).",
        "Better still, keep these out of the public web folder entirely: deploy only the built site, not the repository.",
        "Check that https://your-site/.git/HEAD and https://your-site/.env now return \"Forbidden\" or \"Not found\"."
      ]
    },
    {
      "@id": "shc:remediation/move-backups-offsite",
      "@type": "Remediation",
      "label": "Keep backups off the web server",
      "definition": "Store backups outside the public web folder or, better, off the server entirely.",
      "effort": "hour",
      "steps": [
        "Delete any backup archives or database exports from the public web folder.",
        "Configure your backup plugin to store backups in remote storage (for example S3, Google Drive or Dropbox), not on the server itself.",
        "If backups must stay on the server, keep them in a folder above the public web root."
      ]
    },
    {
      "@id": "shc:remediation/disable-debug-logging",
      "@type": "Remediation",
      "label": "Turn off public debugging",
      "definition": "Set WP_DEBUG and WP_DEBUG_DISPLAY to false on the live site, and keep any debug log outside the public web folder.",
      "effort": "minutes",
      "steps": [
        "Open wp-config.php and set define( 'WP_DEBUG', false ); and define( 'WP_DEBUG_DISPLAY', false );",
        "If you need logging, point WP_DEBUG_LOG to a file outside the public folder instead of wp-content/debug.log.",
        "Delete the existing wp-content/debug.log file."
      ]
    },
    {
      "@id": "shc:remediation/restrict-user-enumeration",
      "@type": "Remediation",
      "label": "Hide usernames",
      "definition": "Block the REST API users endpoint and author archives for visitors who are not signed in, for example with a security plugin.",
      "effort": "minutes",
      "steps": [
        "Install a reputable security plugin with a \"stop user enumeration\" or \"disable REST API users endpoint\" option and enable it.",
        "Check that https://your-site/wp-json/wp/v2/users no longer lists users and that /?author=1 no longer redirects to an author page.",
        "Give administrators a display name that differs from their login name."
      ]
    },
    {
      "@id": "shc:remediation/disable-xmlrpc",
      "@type": "Remediation",
      "label": "Disable XML-RPC",
      "definition": "If you do not use the WordPress mobile app or Jetpack, block /xmlrpc.php at the web server or with a security plugin.",
      "effort": "minutes",
      "steps": [
        "Confirm you do not use the WordPress mobile app, Jetpack, or other tools that need XML-RPC.",
        "Enable \"disable XML-RPC\" in a security plugin, or ask your host to block requests to /xmlrpc.php.",
        "Check that https://your-site/xmlrpc.php now returns \"Forbidden\"."
      ]
    },
    {
      "@id": "shc:remediation/disable-directory-listing",
      "@type": "Remediation",
      "label": "Turn off directory listings",
      "definition": "Disable automatic directory indexes in the web server (for Apache: Options -Indexes).",
      "effort": "minutes",
      "steps": [
        "Ask your host to turn off automatic directory indexes for your site.",
        "On Apache you can add the single line \"Options -Indexes\" to the .htaccess file in the site root.",
        "Check that https://your-site/wp-content/uploads/ no longer shows a list of files."
      ]
    },
    {
      "@id": "shc:remediation/enforce-https",
      "@type": "Remediation",
      "label": "Redirect everything to HTTPS",
      "definition": "Redirect all HTTP requests to HTTPS and make sure the WordPress and site addresses use https://.",
      "effort": "minutes",
      "steps": [
        "Make sure the site has a valid certificate (most hosts provide free Let’s Encrypt certificates).",
        "In Settings → General, change both WordPress Address and Site Address to start with https://.",
        "Turn on \"force HTTPS\" or \"redirect HTTP to HTTPS\" in your hosting panel or CDN.",
        "Check that http://your-site/ now redirects to https://."
      ]
    },
    {
      "@id": "shc:remediation/renew-certificate",
      "@type": "Remediation",
      "label": "Renew the certificate",
      "definition": "Renew the TLS certificate and turn on automatic renewal (most hosts and Let’s Encrypt support this).",
      "effort": "minutes",
      "steps": [
        "In your hosting control panel or CDN, open the SSL/TLS section and renew the certificate.",
        "Turn on automatic renewal so this does not happen again.",
        "Check the new expiry date by clicking the padlock in your browser."
      ]
    },
    {
      "@id": "shc:remediation/install-valid-certificate",
      "@type": "Remediation",
      "label": "Install a valid certificate",
      "definition": "Install a certificate from a trusted authority that covers every hostname the site is served on.",
      "effort": "hour",
      "steps": [
        "Request a certificate covering every name the site uses (for example example.com and www.example.com). Free Let’s Encrypt certificates work.",
        "Install it in your hosting control panel or CDN, replacing the self-signed or mismatched one.",
        "Open the site in a private browser window and check there is no security warning."
      ]
    },
    {
      "@id": "shc:remediation/disable-legacy-tls",
      "@type": "Remediation",
      "label": "Turn off old TLS versions",
      "definition": "Disable TLS 1.0 and 1.1 so only TLS 1.2 and 1.3 are offered.",
      "effort": "minutes",
      "steps": [
        "In your hosting panel, CDN or server configuration, set the minimum TLS version to 1.2.",
        "If you cannot change it, ask your host to disable TLS 1.0 and 1.1.",
        "Run a new scan to confirm."
      ]
    },
    {
      "@id": "shc:remediation/add-security-header",
      "@type": "Remediation",
      "label": "Add the missing security header",
      "definition": "Add the header in your web server configuration, CDN, or with a security-headers plugin.",
      "effort": "minutes",
      "steps": [
        "Decide where to add headers: your CDN (often easiest), your web server configuration, or a security-headers plugin.",
        "Add the header named in this finding. Sensible starting values: Strict-Transport-Security \"max-age=31536000\"; X-Content-Type-Options \"nosniff\"; X-Frame-Options \"SAMEORIGIN\"; Referrer-Policy \"strict-origin-when-cross-origin\"; Permissions-Policy \"camera=(), microphone=(), geolocation=()\".",
        "A Content-Security-Policy needs care: start with Content-Security-Policy-Report-Only and tighten it before enforcing, or ask a developer.",
        "Check the site still works, then run a new scan."
      ]
    },
    {
      "@id": "shc:remediation/fix-cookie-flags",
      "@type": "Remediation",
      "label": "Harden cookie settings",
      "definition": "Make sure session cookies are sent with the Secure, HttpOnly and SameSite attributes.",
      "effort": "hour",
      "steps": [
        "Note the cookie names listed in this finding and which plugin sets them (the name usually gives it away).",
        "Update that plugin; recent versions usually set cookies correctly.",
        "If the issue remains, ask your host or developer to enable session.cookie_secure, session.cookie_httponly and session.cookie_samesite in PHP settings, or contact the plugin author."
      ]
    },
    {
      "@id": "shc:remediation/protect-login",
      "@type": "Remediation",
      "label": "Protect the login page",
      "definition": "Limit failed login attempts, require two-factor authentication for administrators, and consider restricting wp-admin by IP or putting it behind a firewall.",
      "effort": "hour",
      "steps": [
        "Install a reputable security plugin and enable \"limit login attempts\" (or login rate limiting).",
        "Require two-factor authentication for every administrator (see the two-factor guide).",
        "Optionally add a CAPTCHA to the login form, or restrict /wp-admin to your own IP addresses through your host.",
        "Make sure every administrator uses a long, unique password."
      ]
    },
    {
      "@id": "shc:remediation/enable-two-factor",
      "@type": "Remediation",
      "label": "Require two-factor authentication",
      "definition": "Install a two-factor authentication plugin and require it for every administrator and editor.",
      "effort": "minutes",
      "steps": [
        "Install a well-reviewed two-factor plugin (several free ones support authenticator apps).",
        "Turn on two-factor for your own account first and save the backup codes somewhere safe.",
        "Make two-factor mandatory for administrators and editors."
      ]
    },
    {
      "@id": "shc:remediation/incident-response",
      "@type": "Remediation",
      "label": "Respond to a possible compromise",
      "definition": "Treat the site as compromised: keep a copy for investigation, restore clean files from a trusted backup, change every password and key, and check for backdoors. Consider professional help.",
      "effort": "day",
      "steps": [
        "Do not delete anything yet. Make a full copy of the site files and database for investigation.",
        "Change every password: WordPress administrators, hosting control panel, SFTP, database. Regenerate the keys in wp-config.php.",
        "Restore clean files from a backup taken before the problem started, or reinstall WordPress core, plugins and themes from official sources.",
        "Look for unknown administrator accounts and remove them. Scan again, and consider a professional clean-up service if anything remains.",
        "If customer data may have been exposed, check your legal obligations to notify people."
      ]
    },
    {
      "@id": "shc:remediation/restore-core-files",
      "@type": "Remediation",
      "label": "Restore original WordPress files",
      "definition": "Reinstall the same WordPress version over the existing files (Dashboard → Updates → Re-install) to replace modified core files.",
      "effort": "minutes",
      "steps": [
        "Make a backup of the current site.",
        "Go to Dashboard → Updates and click \"Re-install version …\". This replaces core files with fresh copies.",
        "Run a new inside scan to check the modified files are gone. If they come back, follow the compromise guide."
      ]
    },
    {
      "@id": "shc:remediation/fix-file-permissions",
      "@type": "Remediation",
      "label": "Tighten file permissions",
      "definition": "Make wp-config.php readable only by the web server user (for example 400 or 440) and not writable by others.",
      "effort": "minutes",
      "steps": [
        "Using your host’s file manager or SFTP, open the permissions of wp-config.php.",
        "Set them to 440 or 400 (readable by the web server only). If the site breaks, try 640 and ask your host which works.",
        "Check that no files under wp-content are writable by \"everyone\" (777)."
      ]
    },
    {
      "@id": "shc:remediation/review-admin-accounts",
      "@type": "Remediation",
      "label": "Review administrator accounts",
      "definition": "Remove administrator accounts that are not needed and downgrade the rest to the lowest role that works.",
      "effort": "minutes",
      "steps": [
        "Go to Users and filter by Administrator.",
        "Remove accounts that belong to people who no longer need access; reassign their content to another user.",
        "Change the rest to the lowest role that still lets them do their job (Editor, Author, or Shop Manager)."
      ]
    },
    {
      "@id": "shc:exposure/wordpress-version-disclosed",
      "@type": "Exposure",
      "label": "WordPress version is publicly visible",
      "definition": "Your site tells every visitor exactly which WordPress version it runs. Attackers use this to pick exploits that match your version without having to probe.",
      "defaultSeverity": "low",
      "indicatesCompromise": false,
      "appliesTo": [
        "shc:component/wordpress-core"
      ],
      "hasWeakness": [
        "shc:cwe/497"
      ],
      "enables": [
        "shc:capec/170"
      ],
      "mitigatedBy": [
        "shc:control/automatic-updates"
      ],
      "remediatedBy": [
        "shc:remediation/hide-version-info",
        "shc:remediation/update-wordpress-core"
      ],
      "owaspTop10": [
        "A05:2021"
      ],
      "detectedBy": [
        "wp-detect"
      ]
    },
    {
      "@id": "shc:exposure/wordpress-core-outdated",
      "@type": "Exposure",
      "label": "WordPress is out of date",
      "definition": "A newer WordPress release is available. Updates often include security fixes, and older versions are what automated attacks target first.",
      "defaultSeverity": "medium",
      "indicatesCompromise": false,
