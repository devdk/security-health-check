    {
      "@id": "shc:exposure/login-unprotected",
      "@type": "Exposure",
      "label": "Login page has no visible extra protection",
      "definition": "wp-login.php and wp-admin are open to the whole internet with no sign of rate limiting, CAPTCHA or access restriction, so password-guessing bots can work freely.",
      "defaultSeverity": "medium",
