{
  "name": "@shc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "node ../../scripts/build-app.mjs --outdir dist src/main.ts src/cli-intel-sync.ts=intel-sync",
    "start": "node --enable-source-maps dist/main.js",
    "intel:sync": "tsx --env-file=../../.env src/cli-intel-sync.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@shc/companion": "0.1.0",
    "@shc/config": "0.1.0",
    "@shc/core": "0.1.0",
    "@shc/db": "0.1.0",
    "@shc/intel": "0.1.0",
    "@shc/net": "0.1.0",
    "@shc/ontology": "0.1.0",
    "@shc/report": "0.1.0",
    "@shc/scanner": "0.1.0",
    "@shc/shared": "0.1.0",
    "bullmq": "^6.7.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  }
}
