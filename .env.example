# Copy to .env with `npm run setup:env` (fills in random passwords). Never commit .env.

# --- Docker services -------------------------------------------------------
POSTGRES_USER=shc
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_DB=shc
REDIS_PASSWORD={{REDIS_PASSWORD}}

# Host ports, bound to 127.0.0.1 only. Non-standard so they don't clash with other local stacks.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
WEB_HOST_PORT=8080

# --- Services run on your machine (npm run dev:*, migrations, tests) --------
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://shc:{{POSTGRES_PASSWORD}}@localhost:5442/shc
REDIS_URL=redis://:{{REDIS_PASSWORD}}@localhost:6389/0
TEST_DATABASE_URL=postgres://shc:{{POSTGRES_PASSWORD}}@localhost:5442/shc_test
TEST_REDIS_URL=redis://:{{REDIS_PASSWORD}}@localhost:6389/1

API_PORT=3000
# The Vite dev server; links in emails point here when running locally.
WEB_BASE_URL=http://localhost:5173

# Browsers accept Secure cookies on http://localhost. Only set false if yours does not.
COOKIE_SECURE=true
MAIL_TRANSPORT=console

# --- Scanner / ownership checks (optional) -----------------------------------
# Defaults to "SecurityHealthCheck/0.1 (+<WEB_BASE_URL>/scanner)". Must name the product.
# SCANNER_USER_AGENT=
# Comma-separated DNS servers for TXT lookups; empty uses the system resolver.
# DNS_RESOLVERS=1.1.1.1,9.9.9.9
# Development only: hostnames allowed to resolve to private IPs (e.g. a local test WordPress).
# Refused when NODE_ENV=production.
# SCAN_ALLOW_PRIVATE_HOSTS=
# Minutes between scans of the same site (default 15). Lower it for local testing.
# SCAN_COOLDOWN_MINUTES=15

# --- Companion WordPress plugin ---------------------------------------------
# Every plugin site key is derived from this secret (only the API needs it). Changing it
# disconnects every paired plugin. Leave empty to switch pairing off.
PLUGIN_KEY_SECRET={{PLUGIN_KEY_SECRET}}

# --- Vulnerability intelligence (refreshed daily by the worker) --------------
# Free key: sign in at wordfence.com -> Account -> Integrations -> create an API key.
# Required for WordPress plugin/theme/core vulnerability data. Keep it secret.
WORDFENCE_API_KEY=
# Optional: free NVD key (https://nvd.nist.gov/developers/request-an-api-key) for faster PHP CVE syncs.
NVD_API_KEY=
# When the daily refresh runs (UTC, cron syntax).
# INTEL_REFRESH_CRON=17 3 * * *

# --- Local test WordPress (docker compose --profile testwp) ------------------
TESTWP_DB_PASSWORD={{TESTWP_DB_PASSWORD}}
# Admin account of the throwaway test site. The product itself never uses WordPress passwords.
TESTWP_ADMIN_PASSWORD={{TESTWP_ADMIN_PASSWORD}}
TESTWP_HOST_PORT=8081
